# Noctalia configuration for Droidspaces mobile/container
# Matches noctalia v5.0.0 schema (see example.toml in the noctalia repo).

[accessibility]
ui_scale = 1.0

[shell]
font_family = "sans-serif"
clipboard_enabled = true
telemetry_enabled = false
niri_overview_type_to_launch_enabled = false

# ── Wallpaper ─────────────────────────────────────────────────────────────────

[wallpaper]
enabled = true
fill_mode = "stretch"            # center | crop | fit | stretch | repeat | span
fill_color = "on_surface"
transition_duration = 1500
edge_smoothness = 0.3
transition_on_startup = false
directory = "~/Pictures/Wallpapers"

# ── Theme ─────────────────────────────────────────────────────────────────────

[theme]
mode = "dark"                    # dark | light | auto
source = "builtin"               # builtin | wallpaper | community
builtin = "Noctalia"
pure_black_dark = false

# ── Notifications ─────────────────────────────────────────────────────────────

[notification]
enable_daemon = true
show_app_name = true
show_actions = true
layer = "top"                    # top | overlay
scale = 1.0
background_opacity = 0.97
offset_x = 8
offset_y = 8

# ── OSD ───────────────────────────────────────────────────────────────────────

[osd]
position = "top_center"
position_vertical = "top_center"
orientation = "horizontal"
scale = 1.0
background_opacity = 0.97
offset_x = 8
offset_y = 8

[osd.kinds]
volume = true
volume_output = true
volume_input = true
brightness = true
wifi = true
bluetooth = true
power_profile = true
caffeine = true
nightlight = true
dnd = true
lock_keys = true
keyboard_layout = true
privacy = true

# ── Lock Screen ───────────────────────────────────────────────────────────────

[lockscreen]
enabled = true
blurred_desktop = false
blur_intensity = 0.5
tint_intensity = 0.3

# ── Bar (top) ─────────────────────────────────────────────────────────────────

[bar.main]
position = "top"
thickness = 48
background_opacity = 1.0
radius = 0
margin_ends = 0
margin_edge = 0
padding = 14
widget_spacing = 6
scale = 1.0
shadow = false
auto_hide = false
reserve_space = true
capsule = false

start  = ["launcher", "workspaces"]
center = ["clock"]
end    = ["media", "tray", "notifications", "clipboard", "network", "bluetooth", "volume", "brightness", "battery", "control-center", "session"]

# ── Dock (bottom) ─────────────────────────────────────────────────────────────

[dock]
enabled = true
position = "bottom"
icon_size = 48
main_axis_padding = 16
cross_axis_padding = 8
item_spacing = 6
background_opacity = 0.88
radius = 16
margin_ends = 0
margin_edge = 8
shadow = false
show_running = true
auto_hide = false
reserve_space = true
layer = "top"                    # top | overlay
active_scale = 1.0
inactive_scale = 0.85
magnification = true
magnification_scale = 1.45
active_opacity = 1.0
inactive_opacity = 0.85
show_dots = false
show_instance_count = true
launcher_position = "none"       # none | start | end
launcher_icon = "grid-dots"
active_monitor_only = false
pinned = ["org.gnome.Terminal", "org.gnome.Nautilus", "brave-browser", "code.desktop"]