# Noctalia configuration for Droidspaces mobile/container
# Based on example.toml from noctalia repo, optimized for mobile/touch

[core]
# Enable hot reload of config
hot_reload = true
# Log level: trace, debug, info, warn, error
log_level = "info"

# Compositor detection - niri with anland backend
[compositor]
# Force niri backend
preferred = "niri"

# Bar configuration - optimized for mobile screens
[bar]
enabled = true
position = "top"
height = 48
margin = 0
border_radius = 0

[bar.widgets.left]
# Workspace indicator
workspace = {}
# Window title
window_title = { max_length = 50 }

[bar.widgets.center]
# Clock
clock = { format = "%H:%M", tooltip_format = "%A, %d %B %Y" }

[bar.widgets.right]
# System tray
systray = { icon_size = 24 }
# Battery
battery = { show_percentage = true, low_threshold = 20 }
# Network
network = {}
# Audio
audio = { mixer = "pipewire" }
# Brightness
brightness = {}

# Launcher configuration
[launcher]
enabled = true
# Key binding to open (handled by niri config)
# Terminal to use for CLI apps
terminal = "alacritty"
# Icon theme
icon_theme = "Adwaita"

# Notification configuration
[notification]
enabled = true
position = "top-right"
max_visible = 5
default_timeout = 5000
# Notification history
history = { enabled = true, max_count = 100 }

# Dock configuration
[dock]
enabled = true
position = "bottom"
icon_size = 48
padding = 8
auto_hide = false
# Pinned apps
pinned = [
  "org.gnome.Terminal",
  "org.gnome.Nautilus",
  "firefox",
  "code.desktop"
]

# Lock screen
[lock_screen]
enabled = true
# Background
background = { type = "solid", color = "#1a1a2e" }
# Clock
clock = { format = "%H:%M", date_format = "%A, %d %B" }
# Input method
input_method = true

# Wallpaper
[wallpaper]
enabled = true
mode = "stretch"
# Default wallpaper path (will be overridden by user config)
path = "/usr/share/backgrounds/noctalia/default.jpg"

# OSD (On-Screen Display)
[osd]
enabled = true
position = "center"
timeout = 2000
# Volume OSD
volume = { icon = true, bar = true }
# Brightness OSD
brightness = { icon = true, bar = true }

# Clipboard history
[clipboard]
enabled = true
max_history = 50
# Persist across reboots (requires secret service)
persist = false

# Desktop widgets
[widgets]
enabled = true
# Example widgets
# weather = { location = "auto", units = "metric" }
# calendar = {}

# Session actions
[session]
enabled = true
# Power menu options
power = { reboot = true, shutdown = true, suspend = true, hibernate = false, logout = true }

# Theming
[theme]
# Base theme: "light" or "dark"
base = "dark"
# Accent color (hex)
accent = "#ff6b6b"
# Font
font_family = "Noto Sans CJK SC"
font_size = 12
# Border radius
radius = 8
# Blur background
blur = { enabled = true, strength = 16 }

# Input method (fcitx5)
[input_method]
enabled = true
# Preedit and status window positioning
preedit_position = "cursor"
status_position = "bar"

# Plugins (optional)
[plugins]
# Example: extra widgets, launcher providers, etc.
# enabled = ["my-custom-plugin"]